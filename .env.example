# ═══════════════════════════════════════════════════════════════════════════════
# GYM FRONTEND — Environment Variables
#
# Vite loads files in this order (later wins):
#   .env                 → base defaults
#   .env.{mode}          → mode-specific (development / staging / production)
#   .env.local           → local machine overrides (gitignored)
#
# Commands:
#   npm run dev              → mode: development  → uses .env.development
#   npm run build:staging    → mode: staging      → uses .env.staging
#   npm run build            → mode: production   → uses .env.production
# ═══════════════════════════════════════════════════════════════════════════════

# API base URL
# Dev:     /api/v1                                (Vite proxy → localhost:9000)
# Staging: https://api-staging.gymanger.com/api/v1
# Prod:    https://api.gymanger.com/api/v1
VITE_API_URL=/api/v1

# Current environment label (used for runtime checks / analytics)
VITE_APP_ENV=development

# App display name
VITE_APP_NAME=Gymanger
